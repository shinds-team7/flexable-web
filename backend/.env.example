# 로컬 실행용. 이 파일을 .env로 복사하고 값을 채운다. .env는 커밋하지 않는다(저장소 공개).
# 운영은 VM 환경변수로 넣는다. 외부 시세 API는 worker(--spring.profiles.active=...,worker)만 부른다.

# 시세 소스: kiwoom | fake(키 없이 가짜 시세)
MARKET_PRICE_SOURCE=kiwoom
# 종목 목록 소스: krx | kiwoom | fake. 시장별로 기본이 실패할 때(예: KRX ETF API 미승인) 쓸 대체 소스: kiwoom | krx | fake | none
MARKET_INSTRUMENT_SOURCE=krx
MARKET_INSTRUMENT_FALLBACK=kiwoom
# 시장마다 시가총액 상위 몇 종목, 처음 몇 년 치를 받을지
MARKET_TOP_LIMIT=100
MARKET_BACKFILL_YEARS=5

# 키움 REST API (https://openapi.kiwoom.com). 모의투자는 https://mockapi.kiwoom.com
KIWOOM_BASE_URL=https://api.kiwoom.com
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=

# KRX 정보데이터시스템 Open API (https://openapi.krx.co.kr). 유가증권·코스닥·ETF 일별매매정보 이용 신청 필요
KRX_BASE_URL=https://data-dbg.krx.co.kr/svc/apis
KRX_AUTH_KEY=

# 사건 근거 공시: dart | fake | none. OpenDART(https://opendart.fss.or.kr) 인증키. 비어 있으면 공시 단계를 건너뛴다
MARKET_DISCLOSURE_SOURCE=dart
DART_API_KEY=
# 시장 전체로 보는 종목(코스피200 추종 ETF)
MARKET_INDEX_PROXY=069500

# 투자 인사이트 사건 상세의 뉴스 기사(api에서 요청 중 호출, 저장 안 함): naver | fake. NAVER API HUB(ncloud 콘솔) 뉴스 검색 Client ID·Secret.
# 비어 있으면 뉴스 칸만 "불러올 수 없음". 키 없이 예시 기사를 보려면 NEWS_SEARCH_SOURCE=fake
NEWS_SEARCH_SOURCE=naver
NAVER_API_HUB_KEY_ID=
NAVER_API_HUB_KEY=
NAVER_NEWS_DAILY_CAP=

# 목표 안내(api에서 요청 중 호출, 키가 없으면 기본 안내). 빈 설정은 application.yml 기본값을 쓴다.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
GOAL_COACH_FREE_DAILY_LIMIT=
GOAL_COACH_DAILY_CAP=

# 청년 정책(소식) 수집: youthcenter | fake. 온통청년(https://www.youthcenter.go.kr) 오픈API 인증키(적금 정책 수집과 같은 키). 비어 있으면 수집을 건너뛴다
YOUTH_POLICY_SOURCE=youthcenter
YOUTHCENTER_API_KEY=

# 청년 소식 카드 요약(worker, Gemini API https://aistudio.google.com). 비어 있으면 요약 없이 게시한다. 모델·한도는 AI Studio에서 확인
GEMINI_API_KEY=
GEMINI_MODEL=
# 투자 인사이트 사건 AI 개요(worker): gemini | fake(키 없이 예시 문장) | none. 빈 설정은 application.yml 기본값
EVENT_OVERVIEW_SOURCE=gemini
# 개요 전용 Gemini 키·모델(비우면 위 GEMINI_API_KEY·GEMINI_MODEL). 무료 한도는 프로젝트 단위라 다른 Google Cloud 프로젝트의 키여야 한도가 나뉜다
EVENT_OVERVIEW_GEMINI_API_KEY=
EVENT_OVERVIEW_GEMINI_MODEL=
EVENT_OVERVIEW_BATCH_SIZE=
EVENT_OVERVIEW_MAX_CALLS=
# 하루(KST) 호출 상한. DB에 세어 worker를 다시 켜도 넘지 않는다. 비우면 100. Gemini 무료 일일 한도(AI Studio)보다 낮게 둔다
EVENT_OVERVIEW_DAILY_CAP=
