# 로컬 실행용. 이 파일을 .env로 복사하고 값을 채운다. .env는 커밋하지 않는다(저장소 공개).
# 운영은 VM 환경변수로 넣는다. 외부 시세 API는 worker(--spring.profiles.active=...,worker)만 부른다.

# 시세 소스: kiwoom | fake(키 없이 가짜 시세)
MARKET_PRICE_SOURCE=kiwoom
# 종목 목록 소스: krx | kiwoom | fake. 시장별로 기본이 실패할 때(예: KRX ETF API 미승인) 쓸 대체 소스: kiwoom | krx | fake | none
MARKET_INSTRUMENT_SOURCE=krx
MARKET_INSTRUMENT_FALLBACK=kiwoom
# 시장마다 시가총액 상위 몇 종목, 처음 몇 년 치를 받을지
MARKET_TOP_LIMIT=100
MARKET_BACKFILL_YEARS=5

# 키움 REST API (https://openapi.kiwoom.com). 모의투자는 https://mockapi.kiwoom.com
KIWOOM_BASE_URL=https://api.kiwoom.com
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=

# KRX 정보데이터시스템 Open API (https://openapi.krx.co.kr). 유가증권·코스닥·ETF 일별매매정보 이용 신청 필요
KRX_BASE_URL=https://data-dbg.krx.co.kr/svc/apis
KRX_AUTH_KEY=
