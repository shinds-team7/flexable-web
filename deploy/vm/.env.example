# 웹 VM 환경변수 양식. `cp .env.example .env` 후 값을 채운다. .env는 커밋하지 않고 메신저·문서에 붙이지 않는다(저장소 공개).
# 변수 설명은 backend/README.md "환경 변수".

# DB (MySQL 컨테이너와 웹 백엔드가 함께 쓴다)
DB_NAME=flexable_web
DB_USERNAME=flexable_web
# openssl rand -base64 24
DB_PASSWORD=

# 웹 토큰 서명 키. openssl rand -base64 48. 앱 JWT_SECRET과 다른 값
WEB_JWT_SECRET=

# 소셜 로그인. 콜백은 {OAUTH_CALLBACK_BASE_URL}/api/v1/auth/oauth/{kakao|google}/callback
OAUTH_CALLBACK_BASE_URL=https://solpa.shinhanacademy.co.kr
OAUTH_ALLOWED_REDIRECT_URIS=https://solpa.shinhanacademy.co.kr/oauth/callback
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_ADMIN_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 같은 출처(/api 프록시)라 비워 둔다
CORS_ORIGINS=

# 앱 연동. 서비스 키는 앱 서버 WEB_LINK_SERVICE_KEYS 중 하나와 같은 값(팀 비공개 공간).
# 암호화 키는 openssl rand -base64 32, 한 번 정하면 바꾸지 않는다.
APP_LINK_SERVICE_KEY=
APP_LINK_ENCRYPTION_KEY=
# 웹 개인정보처리방침 시행 뒤 마지막에 넣는다(넣는 순간 [앱 연동하기]가 보인다)
APP_LINK_BASE_URL=

# 시세 수집(worker). 키를 넣은 뒤 --profile worker로 켠다
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=
KRX_AUTH_KEY=
# 시장 띠 환율(한국수출입은행 현재환율 API). 비어 있으면 환율 칸만 빠진다
KOREAEXIM_AUTH_KEY=

# 투자 인사이트 사건 상세의 뉴스 기사(api, NAVER API HUB 뉴스 검색). 키는 사람이 이 파일에만 넣는다. 비어 있으면 뉴스 칸만 꺼진다.
NAVER_API_HUB_KEY_ID=
NAVER_API_HUB_KEY=
NAVER_NEWS_DAILY_CAP=

# 목표 안내(api). 키는 방침 시행·api 컨테이너 연결 확인 뒤 사람이 넣는다. 키가 없으면 기본 안내.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
GOAL_COACH_FREE_DAILY_LIMIT=
GOAL_COACH_DAILY_CAP=

# 적금 공시(금융감독원 finlife)·청년정책(온통청년) 수집. 키는 팀 비공개 공간에서 받아 이 파일에만 넣는다.
# SAVINGS_INGEST_ENABLED=true면 api가 시작할 때 DB가 비어 있으면 바로 받고, 이후 매일 10:00(KST)에 갱신한다.
SAVINGS_INGEST_ENABLED=true
FINLIFE_API_KEY=
YOUTHCENTER_API_KEY=

# 청년 소식 카드 요약·투자 인사이트 사건 AI 개요(worker, Gemini API). 비어 있으면 요약·개요 없이 게시한다. 키는 사람이 이 파일에만 넣는다.
GEMINI_API_KEY=
# 사건 AI 개요를 끄려면 none. 비우면 gemini(한 번 호출 10건, 한 번 실행 30번)
EVENT_OVERVIEW_SOURCE=
# 사건 AI 개요 전용 Gemini 키(비우면 GEMINI_API_KEY). 한도를 나누려면 다른 Google Cloud 프로젝트에서 만든 키를 넣는다
EVENT_OVERVIEW_GEMINI_API_KEY=
# 사건 AI 개요 한 번 실행의 호출 상한(비우면 30)과 하루(KST) 호출 상한(비우면 100, DB에 세어 재시작해도 유지). 첫 백필은 deploy/vm/README.md "사건 AI 개요 첫 백필"
EVENT_OVERVIEW_MAX_CALLS=
EVENT_OVERVIEW_DAILY_CAP=
