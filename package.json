{
  "name": "flexable-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:m": "npm --prefix mobile-demo run web",
    "build": "npm run build:web && npm run build:m && node scripts/merge-mobile-demo.mjs",
    "build:web": "tsc -b && vite build",
    "build:m": "npm --prefix mobile-demo run build:web",
    "typecheck": "tsc -b && npm --prefix mobile-demo run typecheck",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  }
}
