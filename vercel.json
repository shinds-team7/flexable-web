{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci && npm --prefix mobile-demo ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/m", "destination": "/m/index.html" },
    { "source": "/m/(.*)", "destination": "/m/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
